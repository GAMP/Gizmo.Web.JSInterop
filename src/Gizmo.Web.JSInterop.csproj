<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    
    <!-- NuGet Package Metadata -->
    <PackageId>Gizmo.Web.JSInterop</PackageId>
    <Version>2.0.0-preview</Version>
    <Authors>Gizmo</Authors>
    <Company>Gizmo</Company>    
    <Description>JavaScript interop library for Blazor applications providing javascript API</Description>
    <PackageTags>blazor;jsinterop;clipboard;print</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/GAMP/Gizmo.Web.JSInterop</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    
    <!-- XML Documentation -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.3" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
